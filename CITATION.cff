    given-names: "Mahamadou Issiaka"
license: CC-BY-4.0
repository-code: "https://github.com/maigus223/data-will"
url: "https://maigus223.github.io/data-will/"
keywords:
  - digital will
  - digital legacy
  - open format
  - specification
  - json schema
